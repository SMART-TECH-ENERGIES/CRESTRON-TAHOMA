/*******************************************************************************************
  SIMPL+ Module Information
  Somfy TaHoma Local API - Controle Velux IO - Version 1.3
*******************************************************************************************
  Dealer Name:
  System Name:
  System Number:
  Programmer:
  Comments:
    Module de pilotage de velux Somfy IO via la passerelle TaHoma (API locale HTTPS/REST)

    Architecture:
      SIMPL+ Module -> TX$ -> [TCP Client SIMPL SSL Port 8443] -> TaHoma -> Velux IO
      SIMPL+ Module <- RX$ <- [TCP Client SIMPL SSL Port 8443] <- TaHoma

    IMPORTANT - Connexion a la demande (connect-on-demand):
      TaHoma est un serveur HTTP standard - il ferme la connexion s il ne recoit
      pas de requete HTTP immediatement apres l etablissement du SSL.
      Ce module fonctionne donc en mode requete/reponse:
        1. Commande recue  -> requete HTTP mise en attente
        2. CONNECT_TCP pulsé -> connexion TCP/SSL etablie
        3. TCP connecte    -> requete envoyee immediatement
        4. Reponse recue   -> parsing + TaHoma ferme la connexion
        5. TCP deconnecte  -> pret pour la prochaine commande
      Pas de connexion persistente. Chaque commande = un cycle connect/send/receive/close.

    Configuration du TCP Client dans SIMPL Windows:
      - IP Address    : Adresse IP de la passerelle TaHoma (ex: 192.168.10.250)
      - Port          : 8443
      - Use SSL       : Coche (TLS actif)
      - Auto Reconnect: Decoche (reconnexion geree par le module)

    Connexions SIMPL Windows:
      TX$           -> TCP Client Tx
      RX$           <- TCP Client Rx
      CONNECT_TCP   -> TCP Client Connect
      TCP_CONNECTED <- TCP Client Connected

    Obtenir le token API local Somfy:
      1. https://developer.somfy.com/ -> My Profile -> Developer Mode -> Generate Token
      2. Copier le token dans le parametre API_TOKEN

    Trouver l URL d un equipement Velux IO:
      GET https://{ip}:8443/enduser-mobile-web/1/enduserAPI/setup/devices
      L URL ressemble a: io://xxxx-xxxx-xxxx/1234567890

    Commandes supportees pour Velux IO:
      OPEN         : Ouvrir completement
      CLOSE        : Fermer completement
      STOP         : Arret en position courante
      MY_POSITION  : Position favorite (bouton MY)
      SET_POSITION : Position precise via POSITION_IN (0=ouvert, 100=ferme)
      GET_STATE    : Interroger la position courante

    IMPORTANT: Un seul module par equipement.
*******************************************************************************************/

/*******************************************************************************************
  Compiler Directives
*******************************************************************************************/
#CATEGORY "46" "TAHOMA IO"
#DEFAULT_NONVOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

/*******************************************************************************************
  Constants
*******************************************************************************************/
#DEFINE_CONSTANT MAX_BUFFER         2000
#DEFINE_CONSTANT HTTP_PORT          8443
#DEFINE_CONSTANT POS_OUVERT         0
#DEFINE_CONSTANT POS_FERME          100

#DEFINE_CONSTANT CMD_OPEN           1
#DEFINE_CONSTANT CMD_CLOSE          2
#DEFINE_CONSTANT CMD_STOP           3
#DEFINE_CONSTANT CMD_MY             4
#DEFINE_CONSTANT CMD_POSITION       5

/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
*******************************************************************************************/
DIGITAL_INPUT   _SKIP_,
                _SKIP_,
                _SKIP_,
                OPEN,
                CLOSE,
                STOP,
                MY_POSITION,
                _SKIP_,
                SET_POSITION_CLK,
                GET_STATE_CLK,
                _SKIP_,
                TCP_CONNECTED;

ANALOG_INPUT    POSITION_IN;

DIGITAL_OUTPUT  _SKIP_,
                _SKIP_,
                _SKIP_,
                CONNECT_TCP,
                _SKIP_,
                CMD_SENT_FB,
                ERROR_FB,
                _SKIP_,
                IS_OPEN_FB,
                IS_CLOSED_FB,
                IS_MOVING_FB;

ANALOG_OUTPUT   POSITION_FB;

STRING_OUTPUT   TX$;
STRING_INPUT    RX$[MAX_BUFFER];

/*******************************************************************************************
  Parameters
*******************************************************************************************/
STRING_PARAMETER API_TOKEN[200];
STRING_PARAMETER DEVICE_URL[200];
STRING_PARAMETER TAHOMA_IP[50];

/*******************************************************************************************
  Global Variables
*******************************************************************************************/
INTEGER     CONNECTED;
INTEGER     WAITING_RESPONSE;
INTEGER     CURRENT_POSITION;
INTEGER     LAST_CMD;
STRING      RX_BUFFER[MAX_BUFFER];
STRING      PENDING_REQUEST[1500];  // Requete en attente d envoi apres connexion

/*******************************************************************************************
  Helper Functions - Envoi en attente (connect-on-demand)
  Note: "\x0D\x0A" = CRLF  |  "\x22" = guillemet double  |  "\x7B" = {
*******************************************************************************************/

// Stocke la requete et declenche la connexion TCP
// Si deja connecte, envoie immediatement
FUNCTION QueueAndConnect(STRING request)
{
    PENDING_REQUEST = request;

    IF (CONNECTED = 1)
    {
        // Connexion deja active: envoyer directement
        TRACE("-> Envoi direct (%d bytes)", LEN(PENDING_REQUEST));
        TX$ = PENDING_REQUEST;
        PENDING_REQUEST = "";
        WAITING_RESPONSE = 1;
    }
    ELSE
    {
        // Connexion inactive: initier la connexion
        // La requete sera envoyee dans PUSH TCP_CONNECTED
        TRACE("-> Connexion TCP en cours...");
        PULSE(20, CONNECT_TCP);
    }
}

// Envoie la requete en attente - appele depuis PUSH TCP_CONNECTED
FUNCTION FlushPendingRequest()
{
    IF (LEN(PENDING_REQUEST) > 0)
    {
        TRACE("-> Envoi requete (%d bytes)", LEN(PENDING_REQUEST));
        TX$ = PENDING_REQUEST;
        PENDING_REQUEST = "";
        WAITING_RESPONSE = 1;
    }
    ELSE
    {
        TRACE("AVERTISSEMENT: TCP connecte mais pas de requete en attente");
    }
}

/*******************************************************************************************
  Helper Functions - Construction des requetes HTTP
*******************************************************************************************/

FUNCTION SendHttpPost(STRING endpoint, STRING jsonBody)
{
    STRING  request[1500];
    INTEGER bodyLen;

    bodyLen = LEN(jsonBody);

    request = "POST " + endpoint + " HTTP/1.1" + "\x0D\x0A" +
              "Host: " + TAHOMA_IP + ":" + ItoA(HTTP_PORT) + "\x0D\x0A" +
              "Authorization: Bearer " + API_TOKEN + "\x0D\x0A" +
              "Content-Type: application/json" + "\x0D\x0A" +
              "Content-Length: " + ItoA(bodyLen) + "\x0D\x0A" +
              "Connection: close" + "\x0D\x0A" +
              "\x0D\x0A" +
              jsonBody;

    TRACE("-> POST %s (body: %d bytes)", endpoint, bodyLen);
    IS_MOVING_FB = 1;
    // CMD_SENT_FB sera pulse dans ProcessHttpResponse apres confirmation HTTP 2xx
    QueueAndConnect(request);
}

FUNCTION SendHttpGet(STRING endpoint)
{
    STRING request[800];

    request = "GET " + endpoint + " HTTP/1.1" + "\x0D\x0A" +
              "Host: " + TAHOMA_IP + ":" + ItoA(HTTP_PORT) + "\x0D\x0A" +
              "Authorization: Bearer " + API_TOKEN + "\x0D\x0A" +
              "Connection: close" + "\x0D\x0A" +
              "\x0D\x0A";

    TRACE("-> GET %s", endpoint);
    QueueAndConnect(request);
}

// JSON exec/apply sans parametre: open, close, stop, my
FUNCTION SendVeluxCmd(STRING cmdName)
{
    STRING jsonBody[500];

    jsonBody = "\x7B\x22label\x22:\x22" + cmdName + "\x22," +
               "\x22actions\x22:[{\x22deviceURL\x22:\x22" + DEVICE_URL + "\x22," +
               "\x22commands\x22:[{\x22name\x22:\x22" + cmdName + "\x22}]}]}";

    SendHttpPost("/enduser-mobile-web/1/enduserAPI/exec/apply", jsonBody);
}

// JSON exec/apply setClosure avec position 0-100
FUNCTION SendVeluxPosition(INTEGER position)
{
    STRING jsonBody[500];

    jsonBody = "\x7B\x22label\x22:\x22setClosure\x22," +
               "\x22actions\x22:[{\x22deviceURL\x22:\x22" + DEVICE_URL + "\x22," +
               "\x22commands\x22:[{\x22name\x22:\x22setClosure\x22,\x22parameters\x22:[" +
               ItoA(position) + "]}]}]}";

    SendHttpPost("/enduser-mobile-web/1/enduserAPI/exec/apply", jsonBody);
}

/*******************************************************************************************
  Helper Functions - Parsing de la reponse HTTP
*******************************************************************************************/

INTEGER_FUNCTION ParseHttpStatus(STRING response)
{
    INTEGER pos;
    STRING  statusStr[4];

    pos = FIND("HTTP/1.", response);
    IF (pos = 0)
        RETURN(0);

    statusStr = MID(response, pos + 9, 3);
    RETURN(ATOI(statusStr));
}

// Extrait la valeur entiere d un champ JSON: "key":NNN
INTEGER_FUNCTION ParseJsonInt(STRING json, STRING key)
{
    INTEGER keyPos, colonPos;
    STRING  searchKey[210];
    STRING  afterKey[150];
    STRING  token[20];
    STRING  dummy[25];

    searchKey = "\x22" + key + "\x22";
    keyPos = FIND(searchKey, json);
    IF (keyPos = 0)
        RETURN(-1);

    afterKey = MID(json, keyPos, 100);
    colonPos = FIND(":", afterKey);
    IF (colonPos = 0)
        RETURN(-1);

    token = MID(afterKey, colonPos + 1, 15);

    WHILE (FIND(",",    token) > 0) { dummy = REMOVE(",",    token); }
    WHILE (FIND("}",    token) > 0) { dummy = REMOVE("}",    token); }
    WHILE (FIND("]",    token) > 0) { dummy = REMOVE("]",    token); }
    WHILE (FIND(" ",    token) > 0) { dummy = REMOVE(" ",    token); }
    WHILE (FIND("\x0D", token) > 0) { dummy = REMOVE("\x0D", token); }
    WHILE (FIND("\x0A", token) > 0) { dummy = REMOVE("\x0A", token); }

    RETURN(ATOI(token));
}

FUNCTION UpdateStateFeedbacks(INTEGER position)
{
    CURRENT_POSITION = position;
    POSITION_FB      = position;
    IS_OPEN_FB       = (position = POS_OUVERT);
    IS_CLOSED_FB     = (position = POS_FERME);
    IS_MOVING_FB     = 0;
    TRACE("<- Position: %d%% (ouvert=%d, ferme=%d)", position, IS_OPEN_FB, IS_CLOSED_FB);
}

FUNCTION ParseStateResponse(STRING response)
{
    INTEGER closureValue;

    closureValue = ParseJsonInt(response, "value");

    IF (closureValue >= 0 && closureValue <= 100)
        UpdateStateFeedbacks(closureValue);
    ELSE
        TRACE("Valeur closure introuvable ou hors plage (0-100)");
}

FUNCTION ProcessHttpResponse(STRING response)
{
    INTEGER httpStatus;

    httpStatus = ParseHttpStatus(response);
    TRACE("<- HTTP Status: %d", httpStatus);

    IF (httpStatus >= 200 && httpStatus < 300)
    {
        PULSE(20, CMD_SENT_FB);
        IF (FIND("\x22value\x22", response) > 0)
            ParseStateResponse(response);
        ELSE
            TRACE("Commande acceptee par TaHoma");
    }
    ELSE IF (httpStatus = 401)
    {
        TRACE("ERREUR 401: Token API invalide ou expire");
        IS_MOVING_FB = 0;
        PULSE(20, ERROR_FB);
    }
    ELSE IF (httpStatus = 404)
    {
        TRACE("ERREUR 404: Device URL introuvable");
        IS_MOVING_FB = 0;
        PULSE(20, ERROR_FB);
    }
    ELSE IF (httpStatus = 0)
    {
        TRACE("ERREUR: Pas de reponse HTTP valide");
        IS_MOVING_FB = 0;
        PULSE(20, ERROR_FB);
    }
    ELSE
    {
        TRACE("ERREUR HTTP: %d", httpStatus);
        IS_MOVING_FB = 0;
        PULSE(20, ERROR_FB);
    }
}

/*******************************************************************************************
  Event Handlers - Commandes Velux IO
  Note: plus de verification CONNECTED - le module gere la connexion a la demande
*******************************************************************************************/

PUSH OPEN
{
    TRACE("Commande: OPEN");
    LAST_CMD = CMD_OPEN;
    SendVeluxCmd("open");
}

PUSH CLOSE
{
    TRACE("Commande: CLOSE");
    LAST_CMD = CMD_CLOSE;
    SendVeluxCmd("close");
}

PUSH STOP
{
    TRACE("Commande: STOP");
    LAST_CMD = CMD_STOP;
    IS_MOVING_FB = 0;
    SendVeluxCmd("stop");
}

PUSH MY_POSITION
{
    TRACE("Commande: MY (position favorite)");
    LAST_CMD = CMD_MY;
    SendVeluxCmd("my");
}

PUSH SET_POSITION_CLK
{
    INTEGER pos;

    pos = POSITION_IN;
    IF (pos > POS_FERME)  pos = POS_FERME;
    IF (pos < POS_OUVERT) pos = POS_OUVERT;

    TRACE("Commande: SET_CLOSURE -> %d%%", pos);
    LAST_CMD = CMD_POSITION;
    SendVeluxPosition(pos);
}

PUSH GET_STATE_CLK
{
    STRING stateEndpoint[300];

    TRACE("Requete: GET etat courant");
    stateEndpoint = "/enduser-mobile-web/1/enduserAPI/setup/devices/" +
                    DEVICE_URL + "/states";
    SendHttpGet(stateEndpoint);
}

/*******************************************************************************************
  Event Handlers - Connexion TCP
  Cycle: CONNECT_TCP pulse -> TCP connecte -> envoi immediat -> reponse -> TaHoma ferme
*******************************************************************************************/

PUSH TCP_CONNECTED
{
    CONNECTED = 1;
    TRACE("TCP connecte -> TaHoma %s:%d", TAHOMA_IP, HTTP_PORT);

    // Envoyer immediatement la requete en attente
    // TaHoma ferme la connexion si rien n arrive rapidement
    FlushPendingRequest();
}

RELEASE TCP_CONNECTED
{
    CONNECTED = 0;
    WAITING_RESPONSE = 0;
    // Comportement normal: TaHoma ferme apres chaque reponse (Connection: close)
    // Pas de reconnexion automatique - la prochaine commande declenchera une nouvelle connexion
    TRACE("TCP deconnecte (fin de cycle requete/reponse)");
}

/*******************************************************************************************
  Event Handler - Reception donnees TCP (reponse HTTP TaHoma)
*******************************************************************************************/

CHANGE RX$
{
    IF (LEN(RX_BUFFER) + LEN(RX$) < MAX_BUFFER)
        RX_BUFFER = RX_BUFFER + RX$;
    ELSE
    {
        TRACE("AVERTISSEMENT: Buffer RX sature - reinitialisation");
        RX_BUFFER = RX$;
    }

    // Attendre la fin des en-tetes HTTP: double CRLF
    IF (FIND("\x0D\x0A\x0D\x0A", RX_BUFFER) = 0)
        RETURN;

    TRACE("<- Reponse recue (%d bytes)", LEN(RX_BUFFER));
    ProcessHttpResponse(RX_BUFFER);

    RX_BUFFER = "";
    WAITING_RESPONSE = 0;
}

/*******************************************************************************************
  Main Function
*******************************************************************************************/
Function Main()
{
    STRING tokenPreview[10];

    TRACE("=== Demarrage TaHoma Velux IO Module v1.3 ===");
    TRACE("Gateway IP : %s", TAHOMA_IP);
    TRACE("Device URL : %s", DEVICE_URL);

    tokenPreview = LEFT(API_TOKEN, 8);
    TRACE("Token      : %s...", tokenPreview);

    CONNECTED        = 0;
    WAITING_RESPONSE = 0;
    CURRENT_POSITION = 0;
    LAST_CMD         = 0;
    RX_BUFFER        = "";
    PENDING_REQUEST  = "";

    TRACE("Mode connect-on-demand: connexion declenchee par chaque commande");
    TRACE("VERIF CABLAGE SIMPL: TCP Client Connected -> TCP_CONNECTED | TX$ -> TCP Tx | TCP Rx -> RX$");
    TRACE("Pret - en attente de commande OPEN/CLOSE/STOP/MY/SET_POSITION/GET_STATE");
}
